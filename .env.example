# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3001
DOMAIN=localhost
BASE_URL=http://localhost:3001

# Redis Configuration
# Optional. Leave empty to use in-memory storage (sessions won't persist across restarts).
# Install Redis and set this to enable persistence: redis://localhost:6379
REDIS_URL=

# Dropbox Sign Configuration
CALLBACK_URL=http://localhost:3001/events/callback

# Security Configuration
# Auto-generated by the setup wizard. To regenerate manually:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=

# Access Control
ADMIN_EMAILS=admin@example.com
ALLOWED_DOMAINS=
ALLOWED_EMAILS=

# Logging
VERBOSE_LOGGING=false
