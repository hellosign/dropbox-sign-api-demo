# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3001
DOMAIN=localhost
BASE_URL=http://localhost:3001

# Redis Configuration
# Optional for local development. Required for production session persistence.
REDIS_URL=redis://localhost:6379

# Dropbox Sign Configuration
CALLBACK_URL=http://localhost:3001/events/callback

# OAuth Configuration
# Required only if you enable OAuth-based login flows.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3001/oauth/callback

# Security Configuration
# Generate production values with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=

# Access Control
ADMIN_EMAILS=admin@example.com
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=

# Logging
VERBOSE_LOGGING=false

# GitHub Configuration
# Optional. Used by the feedback widget to create GitHub issues.
GITHUB_TOKEN=
