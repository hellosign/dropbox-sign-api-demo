<div class="header">
  <div class="header-inner">
    <img src="/main_logo.png" alt="Company Logo" />
    {{#if userEmail}}
    <div style="display:flex; align-items:center; gap:16px; margin-left:auto;">
      <span style="color:#64748b; font-size:14px;">
        <strong>{{userEmail}}</strong>
      </span>
      {{#if isAdmin}}
      <a href="/admin" style="padding:8px 16px; background:#6366f1; color:white; border-radius:6px; text-decoration:none; font-size:14px; font-weight:500; transition:background 0.2s;" onmouseover="this.style.background='#4f46e5'" onmouseout="this.style.background='#6366f1'">
        {{__ "nav.admin_panel"}}
      </a>
      {{/if}}
      <form method="POST" action="/logout" style="margin:0;">
        <button type="submit" style="padding:8px 16px; background:#dc2626; color:white; border:none; border-radius:6px; cursor:pointer; font-size:14px; font-weight:500; transition:background 0.2s;" onmouseover="this.style.background='#b91c1c'" onmouseout="this.style.background='#dc2626'">
          {{__ "common.logout"}}
        </button>
      </form>
    </div>
    {{/if}}
  </div>
</div>

<div class="tab-bar">
  <button class="tab-btn active" data-tab="tab-mandate" data-theme-target="tabLabel">{{tabLabel}}</button>
  <button class="tab-btn" data-tab="tab-editor">{{__ "nav.tabs.document_editor"}}</button>
  <button class="tab-btn" data-tab="tab-status">{{__ "nav.tabs.signature_status"}}</button>
  <button class="tab-btn" data-tab="tab-templates">{{__ "nav.tabs.templates"}}</button>
  {{#if isTeamAdmin}}
  <button class="tab-btn" data-tab="tab-team">{{__ "nav.tabs.team"}}</button>
  {{/if}}
  <button class="tab-btn" data-tab="tab-apps">{{__ "nav.tabs.api_apps"}}</button>
  <button class="tab-btn" data-tab="tab-api-logs">{{__ "nav.tabs.api_logs"}}</button>
  <button class="tab-btn" data-tab="tab-settings">{{__ "nav.tabs.settings"}}</button>
</div>


{{#unless apiKeyConfigured}}
<div id="setup-banner" style="background:#fff3cd;border:1px solid #ffc107;color:#856404;padding:14px 20px;margin:0 20px 16px;border-radius:6px;font-size:14px;line-height:1.6;">
  <strong>Setup required:</strong> No API key is configured. The application cannot connect to the Dropbox Sign API.<br>
  To fix this, add your API key to the <code>.env</code> file:<br>
  <code style="display:inline-block;margin-top:4px;padding:4px 8px;background:#ffeeba;border-radius:3px;">API_KEY=your_dropbox_sign_api_key</code><br>
  <span style="font-size:13px;">Get your API key from <a href="https://app.hellosign.com/home/myAccount#api" target="_blank" style="color:#856404;">hellosign.com</a>, then restart the server.</span>
</div>
{{/unless}}

{{#if apiKeyRotationNotice}}
<div id="key-rotation-banner" style="background:#dbeafe;border:1px solid #3b82f6;color:#1e3a8a;padding:14px 20px;margin:0 20px 16px;border-radius:6px;font-size:14px;line-height:1.6;display:flex;justify-content:space-between;align-items:center;">
  <div>
    <strong>✓ API Key Updated:</strong> You logged in with a new API key.
    {{#if apiKeyRotationNotice.sessionsInvalidated}}
    {{apiKeyRotationNotice.sessionsInvalidated}} other session(s) have been logged out for security.
    {{/if}}
  </div>
  <button class="dismiss-rotation-notice" style="padding:4px 12px;background:#3b82f6;color:white;border:none;border-radius:4px;cursor:pointer;font-size:13px;">Dismiss</button>
</div>
{{/if}}

{{#if showOnboarding}}
<div id="onboarding-modal" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:1000;">
  <div style="background:white;border-radius:12px;padding:32px;max-width:500px;width:90%;box-shadow:0 4px 20px rgba(0,0,0,0.15);">
    {{#if hasExistingData}}
    <!-- Welcome back message for returning users -->
    <h2 style="margin:0 0 16px;font-size:24px;color:#1e293b;">Welcome back! 👋</h2>

    <p style="color:#475569;line-height:1.6;margin-bottom:24px;">
      We found existing settings, themes, and data for your account. Would you like to continue with your existing setup or start fresh?
    </p>

    <div style="background:#f1f5f9;border-radius:8px;padding:16px;margin-bottom:24px;">
      <p style="margin:0 0 8px;color:#334155;font-weight:500;">Your existing data includes:</p>
      <ul style="margin:0;padding-left:24px;color:#64748b;font-size:14px;line-height:1.8;">
        <li>Custom themes and branding settings</li>
        <li>API configuration and test mode preferences</li>
        <li>API activity logs</li>
      </ul>
    </div>

    <div style="display:flex;gap:12px;">
      <button id="continueExistingBtn" style="flex:1;padding:12px 24px;background:#6366f1;color:white;border:none;border-radius:6px;font-weight:500;cursor:pointer;font-size:14px;">
        Continue with Existing Data
      </button>
      <button id="startFreshBtn" style="flex:1;padding:12px 24px;background:#dc2626;color:white;border:none;border-radius:6px;font-weight:500;cursor:pointer;font-size:14px;">
        Start Fresh
      </button>
    </div>
    {{else}}
    <!-- First-time user message -->
    <h2 style="margin:0 0 16px;font-size:24px;color:#1e293b;">Welcome to Sign Portal! 👋</h2>

    <p style="color:#475569;line-height:1.6;margin-bottom:24px;">
      You're all set to start sending signature requests. We've detected that you have access to
      <strong id="existing-app-count">...</strong> API app(s) from your account and team members.
    </p>

    <div style="background:#f1f5f9;border-radius:8px;padding:16px;margin-bottom:24px;">
      <p style="margin:0 0 12px;color:#334155;font-weight:500;">Want to get started quickly?</p>
      <p style="margin:0;color:#64748b;font-size:14px;line-height:1.5;">
        We can create 2 demo API apps for you with preset configurations:
      </p>
      <ul style="margin:8px 0 0 0;padding-left:24px;color:#64748b;font-size:14px;line-height:1.8;">
        <li><strong>acme-app</strong> - General purpose testing app</li>
        <li><strong>hanford-app</strong> - Pre-configured for webhook events</li>
      </ul>
    </div>

    <div style="display:flex;gap:12px;">
      <button id="createDemoAppsBtn" style="flex:1;padding:12px 24px;background:#6366f1;color:white;border:none;border-radius:6px;font-weight:500;cursor:pointer;font-size:14px;">
        Create Demo Apps
      </button>
      <button id="skipOnboardingBtn" style="flex:1;padding:12px 24px;background:#e2e8f0;color:#475569;border:none;border-radius:6px;font-weight:500;cursor:pointer;font-size:14px;">
        Skip for Now
      </button>
    </div>
    {{/if}}

    <p id="onboarding-error" style="color:#dc2626;font-size:13px;margin:12px 0 0;display:none;"></p>
    <p id="onboarding-loading" style="color:#6366f1;font-size:13px;margin:12px 0 0;display:none;">Creating apps...</p>
  </div>
</div>
{{/if}}

<div class="main-layout">
<div class="container">

  <!-- Tab 1: New Mandate -->
  <div id="tab-mandate" class="tab-panel active">
    <h1 data-theme-target="pageTitle">{{pageTitle}}</h1>

    <form id="mandateForm" class="form-grid">
      <div class="app-select-group">
        <label for="appSelect">{{__ "form.label.api_app"}}</label>
        <select id="appSelect" name="client_id">
          <option value="" disabled selected>Loading apps…</option>
        </select>
      </div>
      <div class="theme-select-group">
        <label for="themeSelect" data-tooltip="themeSelect">{{__ "form.label.theme"}}</label>
        <select id="themeSelect" name="theme_id">
        </select>
      </div>
      <div class="create-doc-group">
        <label for="documentMode">{{__ "form.label.document"}}</label>
        <select id="documentMode" name="documentMode" data-tooltip="documentMode">
          <option value="none">{{__ "form.option.use_template"}}</option>
          <option value="auto-append">{{__ "document_mode.auto_append"}}</option>
          <option value="text-tags">{{__ "document_mode.text_tags"}}</option>
          <option value="form-fields">{{__ "document_mode.form_fields"}}</option>
        </select>
      </div>
      <div class="template-select-group">
        <label for="templateSelect">{{__ "form.label.template"}}</label>
        <select id="templateSelect" name="template_id" required>
          <option value="" disabled selected>Loading templates…</option>
        </select>
      </div>
      <div class="choose-file-group">
        <label>&nbsp;</label>
        <button id="autoAppendChooseBtn" type="button" class="choose-file-btn" disabled>{{__ "form.button.choose_file"}}</button>
      </div>

      <div class="client-details">
        <h2 data-theme-target="leftSectionTitle">{{leftSectionTitle}}</h2>
        <div class="form-grid" style="grid-template-columns: repeat(2, 1fr); gap: 20px;">
          <!-- Column 1: Primary signer -->
          <div class="form-group">
            <label for="signerName1" data-theme-target="nameLabel">{{nameLabel}}</label>
            <input id="signerName1" name="name" type="text" value="{{name}}" />
            <div style="margin-top: 8px; display: flex; align-items: center; gap: 12px;">
              <div>
                <input id="singleSigner" name="singleSigner" type="checkbox" data-tooltip="singleSigner" checked />
                <label for="singleSigner">{{__ "form.field.single_signer"}}</label>
              </div>
              <!-- Signing Order Indicator (shown only when multi-signer) -->
              <span id="signingOrderIndicator" style="display: none;">
                <span id="signingOrderToggle" class="signing-order-toggle" title="Click to toggle signing order">↓ then signs ↓</span>
              </span>
            </div>
            <div style="margin-top: 8px;">
              <input id="eidAuth" name="eidAuth" type="checkbox" data-tooltip="eidAuth" />
              <label for="eidAuth">{{__ "form.field.eid_verification"}}</label>
            </div>
          </div>
          <div class="form-group">
            <label for="signerEmail1" data-theme-target="emailLabel">{{emailLabel}}</label>
            <input id="signerEmail1" name="email" type="email" value="{{email}}" />
            <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 8px;">
              <div style="display: flex; align-items: center; gap: 12px; position: relative; min-height: 32px;">
                <div id="smsAuthCheckboxGroup">
                  <input id="smsAuth" name="smsAuth" type="checkbox" data-tooltip="smsAuth" />
                  <label for="smsAuth">{{__ "form.field.sms_authentication"}}</label>
                </div>
                <div id="smsAuthPhoneGroup" style="display: none;">
                  <input id="smsAuthPhone" name="smsPhone" type="tel" data-tooltip="smsPhone" placeholder="+44 7700 900000" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 14px;" />
                </div>
              </div>
              <div id="smsDeliveryCheckboxGroup" style="display: none;">
                <div style="display: flex; align-items: center; gap: 12px; position: relative; min-height: 32px;">
                  <div>
                    <input id="smsDelivery" name="smsDelivery" type="checkbox" data-tooltip="smsDelivery" disabled />
                    <label for="smsDelivery">{{__ "form.field.sms_delivery"}}</label>
                  </div>
                  <div id="smsDeliveryPhoneGroup" style="display: none;">
                    <input id="smsDeliveryPhone" name="smsDeliveryPhone" type="tel" placeholder="+44 7700 900000" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 14px;" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Column 2: Secondary signer -->
          <div class="form-group">
            <label for="signerName2" data-theme-target="secondNameLabel">{{secondNameLabel}}</label>
            <input id="signerName2" name="name2" type="text" value="{{name2}}" />
          </div>
          <div class="form-group">
            <label for="signerEmail2" data-theme-target="secondEmailLabel">{{secondEmailLabel}}</label>
            <input id="signerEmail2" name="email2" type="email" value="{{email2}}" />
          </div>
        </div>
      </div>


      <div class="property-details">
        <h2 data-theme-target="rightSectionTitle">{{rightSectionTitle}}</h2>
        <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
          <div class="form-group">
            <label for="field1" data-theme-target="field1Label">{{field1Label}}</label>
            <input id="field1" name="field1" type="text" value="{{field1}}" required />
          </div>
          <div class="form-group">
            <label for="field2" data-theme-target="field2Label">{{field2Label}}</label>
            <input id="field2" name="field2" type="text" value="{{field2}}" required />
          </div>
          <div class="form-group">
            <label for="field3" data-theme-target="field3Label">{{field3Label}}</label>
            <input id="field3" name="field3" type="text" value="{{field3}}" required />
          </div>
        </div>
      </div>

      <div class="bottom-row-left">
        <button id="sendBtn" class="send-btn" type="submit" data-theme-target="sendBtn">{{sendBtnText}}</button>
        <button id="embedBtn" class="send-btn" type="button" data-tooltip="embedBtn" data-theme-target="embedBtn">{{embedBtnText}}</button>
      </div>
      <div class="bottom-row-right">
        <button id="unclaimedFileBtn" class="send-btn" type="button" data-tooltip="unclaimedFileBtn">{{__ "buttons.prepare_file_unclaimed"}}</button>
        <button id="unclaimedTemplateBtn" class="send-btn" type="button" data-tooltip="unclaimedTemplateBtn">{{__ "buttons.prepare_template_unclaimed"}}</button>
      </div>
    </form>
    <input id="unclaimedFileInput" type="file" accept=".pdf,.doc,.docx" style="display:none;" />
    <input id="autoAppendFileInput" type="file" accept=".pdf,.doc,.docx" style="display:none;" />

  <script>window.hellosignClientId = null;</script>
  <script>window.themesData = {{{themes}}};</script>
  <script>window.currentThemeId = '{{defaultThemeId}}';</script>
  <script>window.formFieldsDefaults = {{{formFieldsDefaults}}};</script>
  <script>window.portalSettings = {{{portalSettings}}};</script>
  <script>window.i18n = window.i18n || {}; window.i18n.noTemplatesForTheme = "{{__ "form.no_templates_for_theme"}}"; window.i18n.sendSignatureDocument = "{{__ "buttons.send_signature_document"}}"; window.i18n.selectTemplateFirst = "{{__ "buttons.select_template_first"}}";</script>

  </div>

  <!-- Tab 2: Document Editor -->
  <div id="tab-editor" class="tab-panel">
    <h1>{{__ "document_editor.title"}}</h1>

    <div class="editor-sub-tab-bar">
      <button class="editor-sub-tab active" data-subtab="subtab-text-tags">{{__ "document_editor.text_tags"}}</button>
      <button class="editor-sub-tab" data-subtab="subtab-form-fields">{{__ "document_editor.form_fields"}}</button>
    </div>

    <!-- Sub-tab 1: Text Tags (existing editor) -->
    <div id="subtab-text-tags" class="editor-sub-panel active">
      <p style="color:#64748b; margin-bottom:16px;">
        Edit the markdown below to create a custom document. Fields from Tab 1 are auto-populated using <code>\{{field}}</code> placeholders.
        Dropbox Sign text tags (e.g. <code>[sig|req|signer1]</code>) become interactive signature fields.
        To add an image, use <code>![alt text](/filename.png)</code> for a file in the public folder, or <code>![alt text](https://...)</code> for a remote URL (PNG/JPEG only).
      </p>
      <div style="margin-bottom:12px; display:flex; align-items:center; gap:12px;">
        <button id="saveAsTemplateBtn" style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #16a34a; background:#16a34a; color:#fff; font-size:0.9rem; cursor:pointer;">{{__ "document_editor.save_as_template"}}</button>
      </div>
      <div class="editor-layout">
        <div class="editor-pane">
          <label for="markdownEditor" style="font-weight:600; margin-bottom:8px; display:block;">{{__ "document_editor.markdown_source"}}</label>
          <textarea id="markdownEditor" name="markdownContent" spellcheck="false"></textarea>
        </div>
        <div class="preview-pane">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
            <label style="font-weight:600; margin:0;">{{__ "document_editor.live_preview"}}</label>
            <label style="display:flex; align-items:center; gap:6px; font-weight:normal; font-size:0.9rem; cursor:pointer;">
              <input type="checkbox" id="previewTagsCheckbox" data-tooltip="previewTagsCheckbox" style="cursor:pointer;" />
              {{__ "document_editor.preview_tags"}}
            </label>
          </div>
          <div id="markdownPreview" class="markdown-preview"></div>
        </div>
      </div>
    </div>

    <!-- Sub-tab 2: Form Fields editor -->
    <div id="subtab-form-fields" class="editor-sub-panel">
      <p style="color:#64748b; margin-bottom:16px;">
        Position signature fields visually using the <code>form_fields_per_document</code> API parameter.
        Adjust the sliders to move and resize each field — the overlay updates in real time.
        These coordinates are sent directly to the Dropbox Sign API when you sign.
      </p>
      <div style="margin-bottom:12px; display:flex; align-items:center; gap:12px;">
        <button id="loadFormFieldsPdfBtn" style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #2563eb; background:#2563eb; color:#fff; font-size:0.9rem; cursor:pointer;">Load Document Preview</button>
        <select id="formFieldsPageSelect" data-tooltip="formFieldsPageSelect" style="padding:0.3rem 0.5rem; border-radius:6px; border:1px solid #cbd5e1; font-size:0.9rem;">
          <option value="0">Page 1</option>
        </select>
        <button id="addFormFieldBtn" style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #16a34a; background:#16a34a; color:#fff; font-size:0.9rem; cursor:pointer;">+ Add Field</button>
      </div>
      <div class="ff-editor-layout">
        <div class="ff-fields-panel">
          <label style="font-weight:600; margin-bottom:8px; display:block;">Fields</label>
          <div id="ffFieldsList"></div>
          <div class="ff-payload-wrapper">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
              <label style="font-weight:600;">API Payload Preview</label>
              <button id="ffSaveDefaultBtn" style="padding:2px 8px; border-radius:4px; border:1px solid #16a34a; background:#16a34a; color:#fff; font-size:11px; cursor:pointer;">Save as Default</button>
              <button id="ffResetDefaultBtn" style="padding:2px 8px; border-radius:4px; border:1px solid #dc2626; background:#fff; color:#dc2626; font-size:11px; cursor:pointer;">Reset</button>
            </div>
            <textarea id="ffApiPayload" class="ff-payload-editor" spellcheck="false"></textarea>
          </div>
        </div>
        <div class="ff-preview-panel">
          <label style="font-weight:600; margin-bottom:8px; display:block;">Document Preview</label>
          <div id="ffDocContainer" class="ff-doc-container">
            <canvas id="ffPdfCanvas"></canvas>
            <div id="ffOverlayLayer" class="ff-overlay-layer"></div>
            <div class="ff-placeholder-msg" id="ffPlaceholderMsg">Click "Load Document Preview" to render the document</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 3: Signature Status -->
  <div id="tab-status" class="tab-panel">
    <div style="display:flex; align-items:center; gap:1rem;">
      <h1 style="margin:0;">{{__ "signature_status.title"}}</h1>
      <span id="statusRefreshing" style="display:none; color:#64748b; font-size:0.85rem; font-style:italic;">{{__ "signature_status.refreshing"}}</span>
      <select id="pageSizeSelect" data-tooltip="pageSizeSelect" style="padding:0.3rem 0.5rem; border-radius:6px; border:1px solid #cbd5e1; font-size:0.9rem;">
        <option value="10">10 {{__ "signature_status.rows"}}</option>
        <option value="25" selected>25 {{__ "signature_status.rows"}}</option>
        <option value="50">50 {{__ "signature_status.rows"}}</option>
        <option value="100">100 {{__ "signature_status.rows"}}</option>
      </select>
      <button id="downloadSelectedBtn" data-tooltip="downloadSelectedBtn" disabled style="padding:0.3rem 0.5rem; border-radius:6px; border:1px solid #16a34a; background:#16a34a; color:#fff; cursor:pointer; opacity:0.5; margin-right:0.5rem; display:inline-flex; align-items:center; justify-content:center; height:28px;" title="Download selected documents">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </button>
      <button id="sendRemindersBtn" data-tooltip="sendRemindersBtn" disabled style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #2563eb; background:#2563eb; color:#fff; font-size:0.9rem; cursor:pointer; opacity:0.5; margin-right:0.5rem;">{{__ "signature_status.send_reminders"}}</button>
      <button id="deleteSelectedBtn" data-tooltip="deleteSelectedBtn" disabled style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #dc2626; background:#dc2626; color:#fff; font-size:0.9rem; cursor:pointer; opacity:0.5;">{{__ "signature_status.delete"}}</button>
    </div>
    <p id="statusLoading" style="color:#64748b; font-style:italic;">{{__ "signature_status.loading"}}</p>
    <p id="statusError" style="color:#dc2626; display:none;"></p>
    <table id="signaturesTable" class="signatures-table" style="display:none;">
      <thead>
        <tr>
          <th style="width:2rem;"><input type="checkbox" id="selectAllSigs" title="{{__ "signature_status.select_all"}}"></th>
          <th>{{__ "signature_status.table.document_name"}}</th>
          <th>{{__ "signature_status.table.sender"}}</th>
          <th>{{__ "signature_status.table.progress"}}</th>
          <th>{{__ "signature_status.table.metadata"}}</th>
          <th>{{__ "signature_status.table.last_update"}}</th>
        </tr>
      </thead>
      <tbody id="signaturesBody"></tbody>
    </table>
  </div>

  <!-- Tab 4: Templates -->
  <div id="tab-templates" class="tab-panel">
    <div style="display:flex; align-items:center; gap:1rem;">
      <h1 style="margin:0;">{{__ "templates.title"}}</h1>
      <select id="templatePageSize" style="padding:0.3rem 0.5rem; border-radius:6px; border:1px solid #cbd5e1; font-size:0.9rem;">
        <option value="25" selected>25 {{__ "templates.rows"}}</option>
        <option value="50">50 {{__ "templates.rows"}}</option>
        <option value="100">100 {{__ "templates.rows"}}</option>
      </select>
      <button id="refreshTemplatesBtn" style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #2563eb; background:#2563eb; color:#fff; font-size:0.9rem; cursor:pointer;">{{__ "templates.refresh"}}</button>
      <input id="templateSearchInput" type="text" placeholder="{{__ "templates.search_placeholder"}}" style="padding:0.3rem 0.5rem; border-radius:6px; border:1px solid #cbd5e1; font-size:0.9rem; width:200px;" />
      <button id="templateSearchBtn" style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #2563eb; background:#2563eb; color:#fff; font-size:0.9rem; cursor:pointer;">{{__ "templates.apply"}}</button>
      <button id="shareTemplatesBtn" data-tooltip="shareTemplatesBtn" disabled style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #2563eb; background:#2563eb; color:#fff; font-size:0.9rem; cursor:pointer;">{{__ "templates.share"}}</button>
      <button id="deleteTemplatesBtn" disabled style="padding:0.3rem 0.8rem; border-radius:6px; border:1px solid #dc2626; background:#dc2626; color:#fff; font-size:0.9rem; cursor:pointer;">{{__ "templates.delete"}}</button>
    </div>
