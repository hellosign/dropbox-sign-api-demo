<!-- Language Selector -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const languageButtons = document.querySelectorAll('.language-selector-btn');
    console.log('[Language Selector] Found buttons:', languageButtons.length);

    languageButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const locale = btn.dataset.locale;
        console.log('[Language Selector] Button clicked, locale:', locale);

        try {
          console.log('[Language Selector] Sending POST to /settings/locale with:', { locale });
          const response = await fetch('/settings/locale', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ locale })
          });

          console.log('[Language Selector] Response status:', response.status);
          const data = await response.json();
          console.log('[Language Selector] Response data:', data);

          if (data.success) {
            console.log('[Language Selector] Success! Reloading page...');
            // Reload page to apply new language
            window.location.reload();
          } else {
            console.error('[Language Selector] Failed:', data);
            showErrorToast(t('toast.error.failed'));
          }
        } catch (error) {
          console.error('[Language Selector] Error:', error);
          showErrorToast(t('toast.error.network'));
        }
      });
    });
  });
</script>
