        prepare_file_unclaimed: "{{__ "buttons.prepare_file_unclaimed"}}",
        prepare_template_unclaimed: "{{__ "buttons.prepare_template_unclaimed"}}"
      },
      form: {
        label: {
          api_app: "{{__ "form.label.api_app"}}",
          theme: "{{__ "form.label.theme"}}",
          document: "{{__ "form.label.document"}}",
          template: "{{__ "form.label.template"}}"
        },
        button: {
          choose_file: "{{__ "form.button.choose_file"}}"
        },
        option: {
          use_template: "{{__ "form.option.use_template"}}"
