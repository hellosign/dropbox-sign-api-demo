      error: {
        unauthorized: "{{__ "error.unauthorized"}}",
        network: "{{__ "error.network"}}",
        server: "{{__ "error.server"}}",
        validation: "{{__ "error.validation"}}"
      },
      api_logs: {
        show_request: "{{__ "api_logs.show_request"}}",
        hide_request: "{{__ "api_logs.hide_request"}}",
        show_response: "{{__ "api_logs.show_response"}}",
        hide_response: "{{__ "api_logs.hide_response"}}",
        copy: "{{__ "api_logs.copy"}}",
        copied: "{{__ "api_logs.copied"}}",
        empty: "{{__ "api_logs.empty"}}",
        empty_filtered: "{{__ "api_logs.empty_filtered"}}",
        empty_initial: "{{__ "api_logs.empty_initial"}}",
        issue: {
          warning_fallback: "{{__ "api_logs.issue.warning_fallback"}}"
        },
        filter: {
          endpoint: "{{__ "api_logs.filter.endpoint"}}"
        },
        status: {
          success: "{{__ "api_logs.status.success"}}",
          error: "{{__ "api_logs.status.error"}}",
          warning: "{{__ "api_logs.status.warning"}}",
          callback: "{{__ "api_logs.status.callback"}}",
          other: "{{__ "api_logs.status.other"}}"
        }
      },
      signature_status: {
        send_reminders: "{{__ "signature_status.send_reminders"}}",
        send_reminders_count: "{{__ "signature_status.send_reminders_count"}}"
      },
      team: {
        members_title: "{{__ "team.members_title"}}",
        member: "{{__ "team.member"}}",
        members: "{{__ "team.members"}}",
        role: {
          admin: "{{__ "team.role.admin"}}",
          member: "{{__ "team.role.member"}}",
          owner: "{{__ "team.role.owner"}}",
          developer: "{{__ "team.role.developer"}}"
        },
        table: {
          name: "{{__ "team.table.name"}}",
          email: "{{__ "team.table.email"}}",
          role: "{{__ "team.table.role"}}",
          team: "{{__ "team.table.team"}}"
        }
      }
    };

    // Translation helper for client-side JavaScript
    function t(key) {
      const keys = key.split('.');
      let result = window.i18n;
      for (const k of keys) {
        result = result?.[k];
      }
      return result || key;
    }
  </script>
</head>
<body>
  <div id="toastContainer" class="toast-container"></div>
  {{{body}}}

  <script src="https://cdn.hellosign.com/public/js/embedded/v2.10.0/embedded.development.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>if(window.pdfjsLib)pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>
  <script src="/main.js?v=1.9.2"></script>
</body>
</html>
