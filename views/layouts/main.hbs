<!DOCTYPE html>
<html lang="{{locale}}">
<head>
  <meta charset="UTF-8" />
  <title>{{title}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/style.css">

  {{!-- Inline client-side translations for JavaScript --}}
  <script>
    window.i18n = {
      common: {
        logout: "{{__ "common.logout"}}",
        save: "{{__ "common.save"}}",
        cancel: "{{__ "common.cancel"}}",
        delete: "{{__ "common.delete"}}",
        edit: "{{__ "common.edit"}}",
        close: "{{__ "common.close"}}",
        loading: "{{__ "common.loading"}}",
        back: "{{__ "common.back"}}",
        search: "{{__ "common.search"}}",
        apply: "{{__ "common.apply"}}",
        refresh: "{{__ "common.refresh"}}",
        yes: "{{__ "common.yes"}}",
        no: "{{__ "common.no"}}"
      },
      toast: {
        success: {
          saved: "{{__ "toast.success.saved"}}",
          deleted: "{{__ "toast.success.deleted"}}",
          updated: "{{__ "toast.success.updated"}}",
          sent: "{{__ "toast.success.sent"}}",
          copied: "{{__ "toast.success.copied"}}"
        },
        error: {
          failed: "{{__ "toast.error.failed"}}",
          network: "{{__ "toast.error.network"}}",
          invalid: "{{__ "toast.error.invalid"}}",
          missing: "{{__ "toast.error.missing"}}"
        }
      },
      buttons: {
        sending: "{{__ "buttons.sending"}}",
        saving: "{{__ "buttons.saving"}}",
        deleting: "{{__ "buttons.deleting"}}",
        loading: "{{__ "buttons.loading"}}",
