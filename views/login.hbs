<!DOCTYPE html>
<html lang="{{locale}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{__ "login.page_title"}}</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: linear-gradient(135deg, #0061FF 0%, #0047B3 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-container {
      max-width: 450px;
      width: 90%;
      padding: 40px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 97, 255, 0.2);
    }

    .login-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .login-title {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #1a1a1a;
    }

    .login-subtitle {
      font-size: 15px;
      color: #5e5e5e;
      margin-bottom: 0;
    }

    .login-form {
      margin-top: 30px;
    }

    .login-form label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
      color: #1a1a1a;
    }

    .login-form input[type="password"],
    .login-form input[type="text"] {
      width: 100%;
      padding: 14px;
      border: 2px solid #d9d9d9;
      border-radius: 8px;
      font-size: 14px;
      margin-bottom: 20px;
      font-family: "SF Mono", Monaco, "Cascadia Code", monospace;
      transition: border-color 0.2s, box-shadow 0.2s;
      box-sizing: border-box;
    }

    .login-form input:focus {
      outline: none;
      border-color: #0061FF;
      box-shadow: 0 0 0 3px rgba(0, 97, 255, 0.1);
    }

    .login-button {
      width: 100%;
      padding: 14px;
      background: #0061FF;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, box-shadow 0.2s;
    }

    .login-button:hover {
      background: #0047B3;
      box-shadow: 0 4px 12px rgba(0, 97, 255, 0.3);
    }

    .login-button:active {
      background: #003D99;
    }

    .error-message {
      background: #fff3e6;
      color: #cc5500;
      padding: 14px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      border-left: 4px solid #ff8533;
    }

    .help-section {
      margin-top: 30px;
      padding-top: 24px;
      border-top: 1px solid #e6e6e6;
    }

    .help-title {
      font-size: 13px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 12px;
    }

    .help-steps {
      font-size: 13px;
      color: #5e5e5e;
      line-height: 1.8;
      margin: 0;
      padding-left: 18px;
    }

    .help-steps li {
      margin-bottom: 6px;
    }

    .help-steps a {
      color: #0061FF;
      text-decoration: none;
      font-weight: 500;
    }

    .help-steps a:hover {
      text-decoration: underline;
    }

    .security-note {
      font-size: 12px;
      color: #8c8c8c;
      text-align: center;
      margin-top: 20px;
      padding: 12px;
      background: #f5f5f5;
      border-radius: 6px;
    }

    /* Honeypot field - visually hidden */
    .honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .client-error {
      background: #fff3e6;
      color: #cc5500;
      padding: 14px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      border-left: 4px solid #ff8533;
      display: none;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-header">
      <h1 class="login-title">{{__ "login.title"}}</h1>
      <p class="login-subtitle">{{__ "login.subtitle"}}</p>
    </div>

    {{#if error}}
    <div class="error-message">{{error}}</div>
    {{/if}}

    <div class="client-error" id="clientError"></div>

    <form class="login-form" method="POST" action="/login" id="loginForm">
      <label for="apiKey">{{__ "login.api_key_label"}}</label>
      <input
        type="password"
        id="apiKey"
        name="apiKey"
        data-tooltip="apiKey"
        required
        placeholder="{{__ "login.api_key_placeholder"}}"
        autocomplete="off"
        autofocus
      >

      <!-- Honeypot field (hidden from humans, bots may fill it) -->
      <input
        type="text"
        name="email_check"
        id="email_check"
        class="honeypot"
        tabindex="-1"
        autocomplete="off"
      >

      <button type="submit" class="login-button">{{__ "login.button"}}</button>
    </form>

    <div class="help-section">
      <div class="help-title">{{__ "login.help_title"}}</div>
      <ol class="help-steps">
        <li><a href="https://app.hellosign.com/home/myAccount#api" target="_blank">{{__ "login.help_step1"}}</a></li>
        <li>{{__ "login.help_step2"}}</li>
        <li>{{__ "login.help_step3"}}</li>
        <li>{{__ "login.help_step4"}}</li>
      </ol>
    </div>

    <div class="security-note">
      ⚠️ <strong>Demo/Testing Only</strong> — Do not use production API keys or sensitive data.
      Your API key is stored only in your browser and is never saved on the server.
    </div>
  </div>

  <script>
    // Clear any stored API key on login page (e.g., after logout)
    sessionStorage.removeItem('dbxSignApiKey');

    // Client-side validation and login via fetch (API key stays browser-side)
    document.getElementById('loginForm').addEventListener('submit', async function(e) {
      e.preventDefault();

      const apiKey = document.getElementById('apiKey').value.trim();
      const honeypot = document.getElementById('email_check').value;
      const errorDiv = document.getElementById('clientError');
      const submitBtn = this.querySelector('.login-button');

      // Hide previous errors
      errorDiv.style.display = 'none';

      // If honeypot is filled, submit normally (server will log as bot)
      if (honeypot) {
        this.submit();
        return;
      }

      // Check length (must be exactly 64 characters)
      if (apiKey.length !== 64) {
        errorDiv.textContent = 'Invalid API key';
        errorDiv.style.display = 'block';
        return;
      }

      // Check format (lowercase alphanumeric only)
      if (!/^[a-z0-9]+$/.test(apiKey)) {
        errorDiv.textContent = 'Invalid API key';
        errorDiv.style.display = 'block';
        return;
      }

      // Check spam patterns (basic client-side check)
      const spamPatterns = ['test', 'password', 'admin', '123456', 'null', 'undefined', 'example'];
      const lowerKey = apiKey.toLowerCase();
      for (const pattern of spamPatterns) {
        if (lowerKey.includes(pattern)) {
          errorDiv.textContent = 'Invalid API key';
          errorDiv.style.display = 'block';
          return;
        }
      }

      // Submit via fetch — server validates but does NOT store the API key
      submitBtn.disabled = true;
      submitBtn.textContent = 'Authenticating...';

      try {
        const resp = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ apiKey, email_check: honeypot })
        });

        const data = await resp.json();

        if (data.success) {
          // Store API key in browser only (never persisted on server)
          sessionStorage.setItem('dbxSignApiKey', data.apiKey);
          window.location.href = '/';
        } else {
          errorDiv.textContent = data.error || 'Login failed';
          errorDiv.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = '{{__ "login.button"}}';
        }
      } catch (err) {
        errorDiv.textContent = 'Connection error. Please try again.';
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = '{{__ "login.button"}}';
      }
    });
  </script>
  <script src="/tooltip.js"></script>
</body>
</html>
