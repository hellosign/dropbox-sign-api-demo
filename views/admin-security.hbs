<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Admin - Security Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/toast.js"></script>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: #f5f7fa;
      min-height: 100vh;
    }

    .admin-header {
      background: white;
      border-bottom: 1px solid #e2e8f0;
      padding: 10px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .admin-title {
      margin: 0;
      display: flex;
      align-items: center;
    }

    .admin-title img {
      height: 80px;
      width: auto;
    }

    .admin-user {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      color: #5e5e5e;
    }

    .back-link {
      padding: 8px 16px;
      background: #0061FF;
      color: white;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
    }

    .back-link:hover {
      background: #0047B3;
    }

    .admin-nav {
      background: white;
      border-bottom: 2px solid #e2e8f0;
      padding: 0 24px;
      display: flex;
      gap: 0;
    }

    .admin-nav a {
      padding: 12px 24px;
      color: #64748b;
      text-decoration: none;
      font-weight: 500;
      font-size: 15px;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      transition: color 0.15s, border-color 0.15s;
    }

    .admin-nav a:hover {
      color: #1e293b;
    }

    .admin-nav a.active {
      color: #2563eb;
      border-bottom-color: #2563eb;
    }

    .admin-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 24px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .stat-card h3 {
      font-size: 14px;
      font-weight: 600;
      color: #5e5e5e;
      margin: 0 0 12px 0;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stat-value {
      font-size: 36px;
      font-weight: 700;
      color: #1a1a1a;
    }

    .section {
      background: white;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .section h2 {
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0 0 20px 0;
    }

    .filters {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .filters input,
    .filters select {
      padding: 8px 12px;
      border: 2px solid #d9d9d9;
      border-radius: 6px;
      font-size: 14px;
    }

    .filters button {
      padding: 8px 16px;
      background: #0061FF;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }

    .filters button:hover {
      background: #0047B3;
    }

    .clear-logs-btn {
      padding: 8px 16px;
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      margin-left: auto;
    }

    .clear-logs-btn:hover {
      background: #c82333;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      font-weight: 600;
      font-size: 13px;
      color: #5e5e5e;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 12px;
      border-bottom: 2px solid #e1e4e8;
    }

    td {
      padding: 12px;
      border-bottom: 1px solid #e1e4e8;
      font-size: 14px;
      color: #1a1a1a;
    }

    .block-btn {
      padding: 6px 12px;
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .block-btn:hover {
      background: #c82333;
    }

    .suspicion-score {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 12px;
    }

    .suspicion-low {
      background: #d4edda;
      color: #155724;
    }

    .suspicion-medium {
      background: #fff3cd;
      color: #856404;
    }

    .suspicion-high {
      background: #f8d7da;
      color: #721c24;
    }

    #blockIPForm {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    #blockIPInput {
      padding: 8px 12px;
      border: 2px solid #d9d9d9;
      border-radius: 6px;
      font-size: 14px;
      width: 200px;
    }

    #blockDuration {
      padding: 8px 12px;
      border: 2px solid #d9d9d9;
      border-radius: 6px;
      font-size: 14px;
    }

    #blockIPForm button {
      padding: 8px 16px;
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }

    #blockIPForm button:hover {
      background: #c82333;
    }

    .empty-state {
      text-align: center;
      padding: 40px;
      color: #5e5e5e;
    }
  </style>
</head>
<body>
  <div class="admin-header">
    <h1 class="admin-title"><img src="/admin_panel_fit.png" alt="Dropbox Sign Demo Admin Panel"></h1>
    <div class="admin-user">
      <span>Signed in as: <strong>{{userEmail}}</strong></span>
      <a href="/" class="back-link">← Back to Portal</a>
    </div>
  </div>

  <nav class="admin-nav">
    <a href="/admin">Users & System</a>
    <a href="/admin/translations">Translation Management</a>
    <a href="/admin/tooltip-management">Tooltip Management</a>
    <a href="/admin/access-control">Access Control</a>
    <a href="/admin/security" class="active">Security Dashboard</a>
    <a href="/admin/theme-management">Theme Management</a>
  </nav>

  <div class="admin-container">
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Total Failed Attempts</h3>
        <div class="stat-value" id="totalAttempts">0</div>
      </div>
      <div class="stat-card">
        <h3>Honeypot Triggers</h3>
        <div class="stat-value" id="honeypotCount">0</div>
      </div>
      <div class="stat-card">
        <h3>Format Rejections</h3>
        <div class="stat-value" id="formatRejectCount">0</div>
      </div>
      <div class="stat-card">
        <h3>API Calls Saved</h3>
        <div class="stat-value" id="apiCallsSaved" data-tooltip="apiCallsSaved">0</div>
      </div>
    </div>

    <div class="section">
      <h2>Top Offending IPs</h2>
      <table id="topIPsTable">
        <thead>
          <tr>
            <th>IP Address</th>
            <th>Attempt Count</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr><td colspan="3" class="empty-state">Loading...</td></tr>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>Recent Security Events</h2>
      <div class="filters">
        <input type="text" id="filterIP" data-tooltip="filterIP" placeholder="Filter by IP">
        <select id="filterEventType" data-tooltip="filterEventType">
          <option value="">All Event Types</option>
          <option value="honeypot_triggered">Honeypot Triggered</option>
          <option value="login_format_rejected">Format Rejected</option>
          <option value="login_failed">Login Failed</option>
          <option value="login_suspicious">Suspicious</option>
          <option value="login_access_denied">Access Denied</option>
          <option value="rate_limit_exceeded">Rate Limited</option>
        </select>
        <button id="applyFilters">Apply</button>
        <button id="refreshBtn">Refresh</button>
        <button id="clearLogsBtn" class="clear-logs-btn">Clear All Logs</button>
      </div>

      <table id="eventsTable">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>IP Address</th>
            <th>Event Type</th>
            <th>Suspicion Score</th>
            <th>Reasons</th>
            <th>Key Info</th>
          </tr>
        </thead>
        <tbody>
          <tr><td colspan="6" class="empty-state">Loading...</td></tr>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h2>Manual IP Blocking</h2>
      <form id="blockIPForm">
        <input type="text" id="blockIPInput" data-tooltip="blockIPInput" placeholder="IP Address (e.g., 192.168.1.1)" required>
        <select id="blockDuration" data-tooltip="blockDuration">
          <option value="3600">1 Hour</option>
          <option value="86400" selected>24 Hours</option>
          <option value="604800">7 Days</option>
          <option value="2592000">30 Days</option>
        </select>
        <button type="submit">Block IP</button>
      </form>
    </div>
  </div>

  <script>
    // Fetch and display stats
    async function loadStats() {
      try {
        const res = await fetch('/admin/api/security/stats');
        const data = await res.json();

        if (data.success) {
          const stats = data.stats;
          document.getElementById('totalAttempts').textContent = stats.totalAttempts || 0;
          document.getElementById('honeypotCount').textContent = stats.honeypot_triggered || 0;
          document.getElementById('formatRejectCount').textContent = stats.login_format_rejected || 0;

          // Calculate API calls saved (honeypot + format rejections)
          const apiCallsSaved = (stats.honeypot_triggered || 0) + (stats.login_format_rejected || 0);
          document.getElementById('apiCallsSaved').textContent = apiCallsSaved;

          // Populate top IPs
          const topIPsBody = document.querySelector('#topIPsTable tbody');
          topIPsBody.innerHTML = '';

          if (stats.topIPs && stats.topIPs.length > 0) {
            stats.topIPs.forEach(({ ip, count }) => {
              const row = document.createElement('tr');
              row.innerHTML = `
                <td>${ip}</td>
                <td>${count}</td>
                <td><button class="block-btn" data-ip="${ip}">Block</button></td>
              `;
              topIPsBody.appendChild(row);
            });

            // Add block button listeners
            document.querySelectorAll('.block-btn').forEach(btn => {
              btn.addEventListener('click', () => blockIP(btn.dataset.ip));
            });
          } else {
            topIPsBody.innerHTML = '<tr><td colspan="3" class="empty-state">No failed login attempts yet</td></tr>';
          }
        }
      } catch (err) {
        console.error('Error loading stats:', err);
      }
    }

    // Fetch and display events
    async function loadEvents(filters = {}) {
      try {
        const params = new URLSearchParams(filters);
        const res = await fetch('/admin/api/security/events?' + params);
        const data = await res.json();

        if (data.success) {
          const eventsBody = document.querySelector('#eventsTable tbody');
          eventsBody.innerHTML = '';

          if (data.events && data.events.length > 0) {
            data.events.forEach(event => {
              const row = document.createElement('tr');
              const timestamp = new Date(event.timestamp).toLocaleString();

              // Determine suspicion score class
              let scoreClass = 'suspicion-low';
              if (event.suspicionScore >= 80) scoreClass = 'suspicion-high';
              else if (event.suspicionScore >= 50) scoreClass = 'suspicion-medium';

              row.innerHTML = `
                <td>${timestamp}</td>
                <td>${event.ip}</td>
                <td>${event.eventType}</td>
                <td><span class="suspicion-score ${scoreClass}" data-tooltip="suspicionScore">${event.suspicionScore}</span></td>
                <td>${(event.reasons || []).join(', ')}</td>
                <td>Len: ${event.attemptedKey?.length || 0}, ${event.attemptedKey?.firstChars || ''}...${event.attemptedKey?.lastChars || ''}</td>
              `;
              eventsBody.appendChild(row);
            });
          } else {
            eventsBody.innerHTML = '<tr><td colspan="6" class="empty-state">No events found</td></tr>';
          }
        }
      } catch (err) {
        console.error('Error loading events:', err);
      }
    }

    // Block IP
    async function blockIP(ip, duration = 86400) {
      if (!confirm(`Block IP ${ip} for ${duration / 3600} hours?`)) {
        return;
      }

      try {
        const res = await fetch('/admin/api/security/block-ip', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ip, duration })
        });

        const data = await res.json();
        alert(data.message || (data.success ? 'IP blocked successfully' : 'Failed to block IP'));

        if (data.success) {
          loadStats();
          loadEvents();
        }
      } catch (err) {
        console.error('Error blocking IP:', err);
        alert('Error blocking IP');
      }
    }

    // Initialize
    loadStats();
    loadEvents();

    // Filter listeners
    document.getElementById('applyFilters').addEventListener('click', () => {
      const filters = {
        ip: document.getElementById('filterIP').value,
        eventType: document.getElementById('filterEventType').value
      };
      loadEvents(filters);
    });

    document.getElementById('refreshBtn').addEventListener('click', () => {
      loadStats();
      loadEvents();
    });

    // Block form
    document.getElementById('blockIPForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const ip = document.getElementById('blockIPInput').value.trim();
      const duration = parseInt(document.getElementById('blockDuration').value);

      if (!ip) {
        alert('Please enter an IP address');
        return;
      }

      blockIP(ip, duration);

      // Clear form
      document.getElementById('blockIPInput').value = '';
    });

    // Clear logs button
    document.getElementById('clearLogsBtn').addEventListener('click', async () => {
      if (!confirm('Are you sure you want to clear ALL security logs? This action cannot be undone.')) {
        return;
      }

      try {
        const res = await fetch('/admin/api/security/clear-logs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await res.json();

        if (data.success) {
          showToast('Security logs cleared successfully', 'success');
          // Refresh the page to show empty state
          loadStats();
          loadEvents();
        } else {
          showToast('Failed to clear security logs: ' + (data.error || 'Unknown error'), 'error');
        }
      } catch (err) {
        console.error('Error clearing logs:', err);
        showToast('Error clearing security logs', 'error');
      }
    });

    // Auto-refresh every 30 seconds
    setInterval(() => {
      loadStats();
      loadEvents();
    }, 30000);
  </script>
</body>
</html>
